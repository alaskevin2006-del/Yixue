{
  "name": "yixue-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "npx http-server dist -p 4173",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "server": "node server/start.js --dev-principal",
    "dev:local": "npm run build && node server/start.js --dev-principal --serve-frontend",
    "test:backend": "node --test --test-concurrency=1 tests/backend/*.test.js",
    "demo:product": "npm run build && node scripts/serve-product-demo.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
