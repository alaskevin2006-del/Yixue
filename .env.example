# Copy to .env (ignored by git) and set a new application password.
# This is NOT the SSH account. There is no built-in/default login password.
YIXUE_ADMIN_USERNAME=admin
YIXUE_ADMIN_PASSWORD=
YIXUE_HOST=127.0.0.1
YIXUE_PORT=3000
YIXUE_ORIGIN=http://127.0.0.1:3000
# Production requires NODE_ENV=production and a real HTTPS origin.
# Docker Compose overrides HOST/DB/UPLOADS paths below.
YIXUE_DB_PATH=.data/yixue.sqlite
YIXUE_UPLOADS_DIR=.data/uploads
YIXUE_AI_BASE_URL=https://api.deepseek.com
YIXUE_AI_API_KEY=
YIXUE_AI_MODEL=deepseek-flash
YIXUE_AI_VISION=true
YIXUE_AI_THINKING=disabled
YIXUE_AI_TIMEOUT_MS=60000
YIXUE_AI_MAX_OUTPUT_TOKENS=4096
YIXUE_AI_RETRIES=1
YIXUE_MAX_CONCURRENT_RUNS=4
YIXUE_MAX_UPLOAD_BYTES=20971520
YIXUE_SESSION_HOURS=168
# Domain deployment: set SITE_ADDRESS to a domain pointing at the server.
SITE_ADDRESS=
